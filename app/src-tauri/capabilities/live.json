{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "live",
  "description": "Live mode: the main window shows dev mode's live pages from the dev clone and may do what it does with the installed ones.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:1421",
      "http://127.0.0.1:1421/*",
      "http://localhost:1421/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-title",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-message",
    "notification:default",
    "allow-relaunch",
    "allow-open-viewer-window",
    "allow-let-foreground",
    "allow-live-leave",
    "allow-live-beat",
    "allow-live-take",
    "allow-core-token"
  ]
}
