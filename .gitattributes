# Generated by ts-rs with LF endings; keep them LF everywhere so test runs leave no diff.
app/src/lib/bindings/**/*.ts text eol=lf

# Shell scripts run on Linux hosts, also when the Hub that sends them was built on Windows.
*.sh text eol=lf

# The bench suites are hashed into their version (`bench/suite.rs`): the same bytes on every machine.
crates/hub-core/bench/*.toml text eol=lf
